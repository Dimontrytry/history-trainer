{
  "name": "history-trainer",
  "version": "0.1.0",
  "description": "Персональная система изучения истории",
  "private": true,
  "author": "History Trainer",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-desktop.mjs --dev",
    "start": "electron .",
    "start:cloud": "node scripts/run-desktop.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/run-integration.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "native:check": "node scripts/check-native.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "node scripts/check-native.mjs",
    "format": "prettier --write src tests scripts --ignore-unknown",
    "format:check": "prettier --check src tests scripts --ignore-unknown"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
